# IntelliShop — app-side environment variables (example only)
#
# Copy to `.env.local` for local development. Never commit `.env*` files with values.
#
# IMPORTANT
# - Everything below is PUBLIC configuration. Any variable read by the app,
#   and in particular any EXPO_PUBLIC_* variable, is compiled into the app bundle
#   and can be read by anyone who downloads the app.
# - Private provider credentials (AI provider key, RevenueCat secret/webhook key,
#   price-data provider keys) must NEVER be placed here, in eas.json, or in EAS
#   environment variables. They live only in Google Cloud Secret Manager and are
#   read by Cloud Functions (see docs/SECURITY_CLOUD_SECRETS_IMPLEMENTATION.md).

# development | staging | production — selects Firebase project, bundle ID and app name
APP_ENV=development

# Firebase client configuration for the selected environment (public identifiers).
# Get these from Firebase console → Project settings → Your apps → iOS app.
# The API key must be restricted in Google Cloud console to the iOS bundle ID and Firebase APIs.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# RevenueCat PUBLIC iOS SDK key (designed to be shipped in apps). Not the secret API key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Firebase App Check debug token — development builds on simulators only. Leave empty otherwise.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
