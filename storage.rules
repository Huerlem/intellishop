rules_version = '2';

// IntelliShop V2 — Cloud Storage Security Rules.
// Only profile photos are stored. Each user can read and write only their own folder.
// Files must be images under 5 MB. Everything else is denied.
// Tests: rules-tests/storage.rules.test.ts.

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
