import OpenAI from 'openai';

// Get API key directly from environment variables
const EXPO_PUBLIC_OPENAI_API_KEY = process.env.EXPO_PUBLIC_OPENAI_API_KEY;

export const getOpenAIService = () => {
  if (!EXPO_PUBLIC_OPENAI_API_KEY) {
    throw new Error('OpenAI API key is not defined. Check your .env file');
  }

  return new OpenAI({
    apiKey: EXPO_PUBLIC_OPENAI_API_KEY,
    dangerouslyAllowBrowser: true,
  });
};