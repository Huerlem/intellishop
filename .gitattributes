# Normalise line endings: text files are stored and checked out with LF on every platform
# (including Windows), so diffs show only real changes and Node/Expo tooling sees one format.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.p8 binary
*.p12 binary
*.jks binary
*.zip binary
*.bundle binary
