# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native folders (generated by `expo prebuild`; EAS builds regenerate them)
/ios
/android

# Environment files — never commit real values. Only .env.example is tracked.
.env
.env.*
!.env.example

# Apple / Google credentials and signing material
*.p8
*.p12
*.key
*.pem
*.jks
*.mobileprovision
*.keystore
GoogleService-Info.plist
google-services.json
*service-account*.json
credentials.json

# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
functions/lib/
functions/node_modules/
functions/.env*
!functions/.env.example
functions/.secret.local

# Logs and OS files
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.DS_Store
Thumbs.db

# Test output
coverage/

# Keep validation evidence logs that are deliberately committed
!docs/validation/*.log
