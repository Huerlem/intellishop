{
  "name": "intellishop",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "export:ios": "expo export --platform ios --output-dir dist",
    "scan:bundle": "node scripts/scan-bundle-for-secrets.mjs dist",
    "doctor": "expo-doctor",
    "legal:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal/build-legal-site.mjs",
    "legal:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal/build-legal-site.mjs --report",
    "legal:emit-app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal/build-legal-site.mjs --emit-app",
    "legal:check-app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal/build-legal-site.mjs --check-app",
    "legal:release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal/build-legal-site.mjs --release"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "firebase": "11.10.0",
    "formik": "^2.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.3",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/docs/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|firebase|@firebase/.*)"
    ]
  }
}
